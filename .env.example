# calmcp configuration (local / stdio development).
# On SAP BTP these values come from the bound Destination service instead — see README.

# --- Sandbox mode (SAP Business Accelerator Hub) ---
# When true, calls go to https://sandbox.api.sap.com/SAPCALM using a static API key.
CALM_SANDBOX=false
CALM_API_KEY=

# --- OAuth2 client-credentials mode (productive tenant) ---
# Required when CALM_SANDBOX=false and no Destination is bound.
CALM_TENANT=
CALM_REGION=eu10
CALM_CLIENT_ID=
CALM_CLIENT_SECRET=

# --- HTTP transport (BTP / remote clients) ---
PORT=8080
# Comma-separated list of allowed CORS origins for browser-based clients ("*" to allow all).
# Leave empty to send no CORS headers.
CALM_CORS_ORIGINS=
# Optional shared secret guarding the /mcp endpoint. Callers send "Authorization: Bearer <key>".
# Use this for Microsoft Copilot Studio or other API-key clients. Generate with: openssl rand -base64 48
# Without a key (or a bound XSUAA service) the HTTP transport refuses to start.
CALM_HTTP_API_KEY=
# Local development only: serve an open /mcp on 127.0.0.1 when no auth is configured.
CALM_HTTP_ALLOW_UNAUTHENTICATED=false

# --- Behaviour ---
CALM_DEBUG=false
CALM_TIMEOUT_SECONDS=30
# Maximum size of a tool response in bytes. Beyond this calmcp returns a summary naming how to
# narrow the query, instead of letting the AI client truncate the JSON mid-record. Lower it for
# hosts with a tighter payload limit.
CALM_MAX_RESPONSE_BYTES=100000
CALM_TOKEN_REFRESH_BUFFER_SECONDS=5
# Name of the bound BTP destination pointing at the Cloud ALM API (HTTP transport on BTP).
CALM_DESTINATION_NAME=SAP_CALM

# --- Write access (off by default) ---
# calmcp is read-only unless this is true. When enabled it registers one extra tool, calm_create,
# which only CREATES new documents and library entries (cross-library applications, configurations,
# configuration activities, developments, interfaces). Nothing is ever updated or deleted.
# Requires the calm-api.documents.write / calm-api.lib.write scopes on the OAuth2 client.
CALM_WRITE_ENABLED=false
