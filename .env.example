# calmcp configuration (local / stdio development).
# On SAP BTP these values come from the bound Destination service instead: see the README section
# "Deploy to SAP BTP Cloud Foundry".

# --- Sandbox mode (SAP Business Accelerator Hub) ---
# When true, calls go to https://sandbox.api.sap.com/SAPCALM using a static API key.
CALM_SANDBOX=false
CALM_API_KEY=

# --- OAuth2 client-credentials mode (productive tenant) ---
# Required when CALM_SANDBOX=false and no Destination is bound.
CALM_TENANT=
CALM_REGION=eu10
CALM_CLIENT_ID=
CALM_CLIENT_SECRET=

# --- HTTP transport (BTP / remote clients) ---
# CALM_TRANSPORT=http starts the HTTP transport, like the --http flag.
# CALM_TRANSPORT=http
PORT=8080
# Comma-separated list of exact CORS origins for browser-based clients, e.g.
# http://localhost:6274 for the MCP Inspector. A wildcard ("*") is refused at startup.
# Leave empty to send no CORS headers (MCP clients such as Claude Desktop do not need any).
CALM_CORS_ORIGINS=
# Optional shared secret guarding the /mcp endpoint. Callers send "Authorization: Bearer <key>".
# Use this for Microsoft Copilot Studio or other API-key clients. Generate with: openssl rand -base64 48
# Without a key (or a bound XSUAA service) the HTTP transport refuses to start.
CALM_HTTP_API_KEY=
# Local development only: serve an open /mcp on 127.0.0.1 when no auth is configured.
CALM_HTTP_ALLOW_UNAUTHENTICATED=false
# With XSUAA bound: the public base URL for OAuth metadata (defaults to the Cloud Foundry route),
# a secret that keeps dynamically registered clients valid across redeploys, and extra OAuth redirect
# URI globs (comma-separated) for MCP clients beyond the built-in list.
# CALM_PUBLIC_URL=https://calmcp-srv.cfapps.eu10.hana.ondemand.com
# CALM_DCR_SIGNING_SECRET=
# CALM_OAUTH_REDIRECT_PATTERNS=

# --- Behaviour ---
CALM_DEBUG=false
CALM_TIMEOUT_SECONDS=30
# Maximum size of a tool response in bytes. Beyond this calmcp returns a summary naming how to
# narrow the query, instead of letting the AI client truncate the JSON mid-record. Lower it for
# hosts with a tighter payload limit.
CALM_MAX_RESPONSE_BYTES=100000
CALM_TOKEN_REFRESH_BUFFER_SECONDS=5
# Name of the bound BTP destination pointing at the Cloud ALM API. Set on BTP only: when present it
# takes precedence over the OAuth2 settings above, so leave it commented out for local use.
# CALM_DESTINATION_NAME=SAP_CALM

# --- Write access (off by default) ---
# calmcp is read-only unless this is true. When enabled it registers one extra tool, calm_create,
# which only CREATES: documents, features, tasks (incl. user stories, defects), task comments,
# library entries and links between existing objects. Nothing is ever updated or deleted by it.
# Requires the matching write scopes on the OAuth2 client: calm-api.documents.write,
# calm-api.features.write, calm-api.tasks.write, calm-api.testcases.write, calm-api.lib.write.
CALM_WRITE_ENABLED=false

# --- Update access (off by default, separate from write access) ---
# When true, registers calm_update, which changes fields of EXISTING features (title, description,
# status, priority, ...). Every call is checked against concurrent edits and refused when it would
# drop an image from the description. Requires calm-api.features.write on the OAuth2 client.
CALM_UPDATE_ENABLED=false
