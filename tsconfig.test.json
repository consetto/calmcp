{
  // Type-checks the tests together with the sources they import. Vitest strips types without
  // checking them and `npm run build` compiles src only, so without this a test could drift from
  // the real signatures unnoticed. Never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": "."
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
